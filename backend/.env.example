# AI Creator Studio Backend Environment Variables

# ==========================================
# AI Model Configuration
# ==========================================
# AI_PROVIDER: 选择AI提供商
# - mock: 使用模拟数据（无需API密钥）
# - openai: 使用OpenAI GPT模型
# - deepseek: 使用DeepSeek模型
AI_PROVIDER=deepseek

# AI_MODEL: 模型名称（可选）
# - OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# - DeepSeek: deepseek-chat, deepseek-coder
AI_MODEL=deepseek-chat

# ==========================================
# API Keys
# ==========================================
# OpenAI API 密钥 (使用OpenAI时必填)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek API 密钥 (使用DeepSeek时必填)
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ==========================================
# Server Configuration
# ==========================================
HOST=0.0.0.0
PORT=8000
DEBUG=true

# ==========================================
# CORS Configuration
# ==========================================
# 允许的前端地址（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# Image Generation (Replicate/Flux)
# ==========================================
# Replicate API 密钥（用于Flux图像生成）
# 获取地址: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=your_replicate_api_key_here

# 默认图像生成模型
# 可选: flux-schnell, flux-dev, flux-pro
IMAGE_MODEL=flux-schnell

# ==========================================
# Video Generation (Runway/Kling/VEO)
# ==========================================
# 视频生成提供商
# 可选: mock, runway, kling, veo
VIDEO_PROVIDER=mock

# Runway API 密钥（用于Gen-3图生视频）
# 获取地址: https://runwayml.com/
RUNWAY_API_KEY=your_runway_api_key_here

# Kling API 密钥（快手可灵AI）
# 获取地址: https://klingai.com/
KLING_API_KEY=your_kling_api_key_here
KLING_ACCESS_KEY=your_kling_access_key_here

# ==========================================
# Google AI (Nano Banana / VEO)
# ==========================================
# Google API 密钥（用于Nano Banana图像生成和VEO视频生成）
# 获取地址: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud 项目ID（VEO Vertex AI模式需要）
GOOGLE_PROJECT_ID=your_google_project_id_here
GOOGLE_LOCATION=us-central1

# VEO模型版本
# 可选: veo-2.0-generate-001, veo-3.0-generate-001,veo-3.1-fast-generate-001
VEO_MODEL=veo-3.1-fast-generate-001

